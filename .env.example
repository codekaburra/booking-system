# ============================================================
# 環境變數範本 — 複製為 .env.local 後填入實際值
#   cp .env.example .env.local
# 每店一個 Supabase 專案;值在 Supabase Dashboard → Settings → API
# ============================================================

# Supabase 專案 URL(例:https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# 公開 anon key(瀏覽器端使用;受 RLS 限制)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key(僅 server 端使用,繞過 RLS;絕不可外洩到前端或 commit)
SUPABASE_SERVICE_ROLE_KEY=

# --- 之後階段使用(先留空)---
# Resend Email 通知(P4)
# RESEND_API_KEY=
# Google Calendar 單向推送(P7)
# GOOGLE_SERVICE_ACCOUNT_KEY=
# COMPANY_GCAL_ID=
